# Binaries
/bin/
/mycel
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of the go coverage tool
*.out
coverage.html

# Go workspace file
go.work

# Dependency directories
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/

# Local environment files
.env
.env.local
*.local.hcl

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Local data (databases, etc)
data/

# Generated WASM test fixtures
internal/plugin/validator.wasm

# Claude Code instructions and local settings (not part of the codebase)
CLAUDE.md
CLAUDE.local.md
.claude/

# Benchmark / load testing — the suite is published, its state and output are not
benchmark/.terraform/
benchmark/terraform.tfstate
benchmark/terraform.tfstate.backup
benchmark/terraform.tfvars
benchmark/results/

# SQLite databases the examples create when they run, and the WAL sidecars
# that come with them. Nothing tracked ends in .db, and `git add -A` in this
# repo has picked up untracked local files before.
*.db
*.db-wal
*.db-shm

# MkDocs build output
site/

# Marketing / article drafts (not part of the codebase)
/articles/

# Local monitoring stack (Prometheus + Grafana) — dev aid, not part of the runtime
/monitoring/

# Coverage counters dropped by the integration suite when built with -cover
tests/integration/.coverage/
tests/integration/.coverage-unit/
tests/integration/.coverage-merged/
tests/integration/coverage.out

# Rust build output for the plugin examples. The compiled connector.wasm sits
# beside its manifest and is committed; this is everything else cargo writes.
examples/plugin/plugins/*/target/
tests/integration/config/plugins/*/target/

# The SSH key pair the integration suite generates per run
tests/integration/ssh/id_ed25519
tests/integration/ssh/id_ed25519.pub
tests/integration/ssh/authorized_keys
