# gRPC server
connector "grpc_api" {
  type   = "grpc"
  driver = "server"

  host        = "0.0.0.0"
  port        = 50051
  proto_path  = "/etc/mycel/protos"
  proto_files = ["test.proto"]

  # Written as a word on purpose: env() hands back strings, and reading a
  # switch as a native boolean only meant a spelt-out value fell through to
  # the default.
  reflection = "true"

  # The interceptor behind this was never invoked: the server handed it to the
  # method handler and the handler ignored it, so every call was answered
  # whatever it carried.
  auth {
    type   = "api_key"
    keys   = ["grpc-test-key"]
    public = ["/integration.UserService/ListUsers"]
  }
}
