# Redis cache
connector "redis_cache" {
  type   = "cache"
  driver = "redis"
  url    = "redis://redis:6379"
}

# Memory cache
connector "memory_cache" {
  type   = "cache"
  driver = "memory"
  default_ttl = "60s"
}

# Redis reached through Sentinel.
#
# The connector does not connect to a server it was given: it asks Sentinel
# which server is master and connects to that. Which means the block is only
# exercised by pointing it at a Sentinel that answers — this one watches the
# redis above.
connector "sentinel_cache" {
  type   = "cache"
  driver = "redis"

  sentinel {
    master_name = "mymaster"
    nodes       = ["redis-sentinel:26379"]
  }
}

# Redis in cluster mode.
#
# A cluster is not one server: the key space is split into slots and each node
# owns a share, so the client is given the nodes and asks them who holds what.
# Writing the block is what builds that client — one address would be a plain
# connection to a single node, which is a different thing.
connector "cluster_cache" {
  type   = "cache"
  driver = "redis"

  cluster {
    nodes = ["redis-cluster-1:6379", "redis-cluster-2:6379", "redis-cluster-3:6379"]
  }
}
