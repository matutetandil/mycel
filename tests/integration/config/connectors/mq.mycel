# RabbitMQ publisher
connector "rabbit_pub" {
  type   = "mq"
  driver = "rabbitmq"

  host     = env("RABBITMQ_HOST", "localhost")
  port     = env("RABBITMQ_PORT", 5672)
  username = env("RABBITMQ_USER", "guest")
  password = env("RABBITMQ_PASS", "guest")
  vhost    = "/"

  publisher {
    exchange     = ""
    routing_key  = "test_queue"
    persistent   = true
    content_type = "application/json"
  }
}

# RabbitMQ consumer
connector "rabbit_sub" {
  type   = "mq"
  driver = "rabbitmq"

  host     = env("RABBITMQ_HOST", "localhost")
  port     = env("RABBITMQ_PORT", 5672)
  username = env("RABBITMQ_USER", "guest")
  password = env("RABBITMQ_PASS", "guest")
  vhost    = "/"

  queue {
    name              = "test_queue"
    durable           = true
    auto_delete       = false
    create_if_missing = true
  }

  consumer {
    auto_ack    = false
    concurrency = 1
    prefetch    = 10
  }
}

# RabbitMQ publisher for fan-out tests
connector "rabbit_fanout_pub" {
  type   = "mq"
  driver = "rabbitmq"

  host     = env("RABBITMQ_HOST", "localhost")
  port     = env("RABBITMQ_PORT", 5672)
  username = env("RABBITMQ_USER", "guest")
  password = env("RABBITMQ_PASS", "guest")
  vhost    = "/"

  publisher {
    exchange     = ""
    routing_key  = "fanout_queue"
    persistent   = true
    content_type = "application/json"
  }
}

# RabbitMQ consumer for fan-out tests (multiple flows share this connector)
connector "rabbit_fanout_sub" {
  type   = "mq"
  driver = "rabbitmq"

  host     = env("RABBITMQ_HOST", "localhost")
  port     = env("RABBITMQ_PORT", 5672)
  username = env("RABBITMQ_USER", "guest")
  password = env("RABBITMQ_PASS", "guest")
  vhost    = "/"

  queue {
    name              = "fanout_queue"
    durable           = true
    auto_delete       = false
    create_if_missing = true
  }

  consumer {
    auto_ack    = false
    concurrency = 1
    prefetch    = 10
  }
}

# Kafka publisher
connector "kafka_pub" {
  type   = "mq"
  driver = "kafka"

  brokers = [env("KAFKA_BROKERS", "localhost:9092")]

  producer {
    # A default topic, which every flow here overrides with its own target.
    # Configuring one used to make every publish through this connector fail:
    # the topic reached both the writer and the message, which kafka-go
    # refuses. Left set on purpose, so the suite would notice if it came back.
    topic = "mycel-default"
  }
}

# Kafka consumer
connector "kafka_sub" {
  type   = "mq"
  driver = "kafka"

  brokers = [env("KAFKA_BROKERS", "localhost:9092")]

  consumer {
    group_id = "integration-test"
    topics   = ["test_topic"]
  }
}

# --- Requeue with an identifier ---------------------------------------------
#
# A filter that requeues needs something to count redeliveries under, or a
# message nobody wants circles for ever. id_field names the expression that
# identifies it — and every form the documentation shows failed to evaluate,
# so the identifier was always empty and the consumer fell back to
# acknowledging: a rejected message dropped rather than retried.

connector "rabbit_requeue_pub" {
  type   = "mq"
  driver = "rabbitmq"

  host     = env("RABBITMQ_HOST", "localhost")
  port     = env("RABBITMQ_PORT", 5672)
  username = env("RABBITMQ_USER", "guest")
  password = env("RABBITMQ_PASS", "guest")
  vhost    = "/"

  publisher {
    exchange     = ""
    routing_key  = "requeue_queue"
    persistent   = true
    content_type = "application/json"
  }
}

connector "rabbit_requeue_sub" {
  type   = "mq"
  driver = "rabbitmq"

  host     = env("RABBITMQ_HOST", "localhost")
  port     = env("RABBITMQ_PORT", 5672)
  username = env("RABBITMQ_USER", "guest")
  password = env("RABBITMQ_PASS", "guest")
  vhost    = "/"

  queue {
    name              = "requeue_queue"
    durable           = true
    auto_delete       = false
    create_if_missing = true
  }

  consumer {
    auto_ack    = false
    concurrency = 1
    prefetch    = 10
  }
}

# --- Kafka: a message a filter turns away -----------------------------------
#
# Kafka has no requeue — an offset moves forward and does not come back — so a
# rejected message is republished to <topic>.dlq. That path needs a broker: the
# republish builds a writer and puts the message on another topic, which is
# exactly what a unit test cannot do.

connector "kafka_dlq_pub" {
  type   = "mq"
  driver = "kafka"

  brokers = [env("KAFKA_BROKERS", "localhost:9092")]

  producer {
    acks = "all"
  }
}

connector "kafka_dlq_sub" {
  type   = "mq"
  driver = "kafka"

  brokers = [env("KAFKA_BROKERS", "localhost:9092")]

  consumer {
    group_id = "integration-dlq"
    topics   = ["dlq_topic"]
  }
}

# Reads what ended up in the dead-letter topic.
connector "kafka_dlq_watch" {
  type   = "mq"
  driver = "kafka"

  brokers = [env("KAFKA_BROKERS", "localhost:9092")]

  consumer {
    group_id = "integration-dlq-watch"
    topics   = ["dlq_topic.dlq"]
  }
}
