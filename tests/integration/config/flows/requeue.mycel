# A message the flow does not want, requeued a bounded number of times.
#
# Every expression here goes through input.body: a message from a queue arrives
# wrapped in an envelope — body, headers, properties, routing_key, exchange —
# so the fields somebody published are one level down. The docs show both forms
# and only this one works for an MQ source.
#
# The filter rejects everything that is not marked wanted, and the policy is to
# put it back. What stops that being a loop is the identifier: the consumer
# counts redeliveries per message and acknowledges once the count is reached.
# id_field is the expression that produces it.

flow "requeue_bounded" {
  from {
    connector = "rabbit_requeue_sub"

    filter {
      condition   = "input.body.wanted == true"
      on_reject   = "requeue"
      max_requeue = 2
      id_field    = "input.body.reference"
    }
  }

  to {
    connector = "postgres"
    target    = "items"
  }

  transform {
    title  = "input.body.reference"
    status = "\"wanted\""
  }
}

# Publishing side, so a test can put a message on that queue over HTTP.
flow "publish_requeue" {
  from {
    connector = "api"
    operation = "POST /test/requeue"
  }
  to {
    connector = "rabbit_requeue_pub"
  }
}
