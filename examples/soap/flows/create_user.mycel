# Create user via SOAP
#
# SOAP operation: CreateUser
# Expects: <Email>...</Email> <Name>...</Name>
# Returns: created user row

flow "create_user" {
  from {
    connector = "soap_server"
    operation = "CreateUser"
  }

  validate {
    input = "type.user"
  }

  # The elements are named as SOAP names them and the columns as a database
  # does. This is where the two meet.
  transform {
    email = "input.Email"
    name  = "input.Name"
  }

  to {
    connector = "sqlite"
    target    = "users"
  }
}
