connector "api" {
  type = "rest"
  port = 3000
}

connector "orders_db" {
  type     = "database"
  driver   = "sqlite"
  # A file, not ":memory:": each connection in the pool gets its own private
  # in-memory database, so the order written by one request is not there for
  # the next transition.
  database = "./data/orders.db"
}

connector "notifications" {
  type    = "http"
  base_url = env("NOTIFICATIONS_URL", "http://localhost:6000")
}
