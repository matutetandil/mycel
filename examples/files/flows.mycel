# File Operations Flows
#
# The file connector stores the bytes; the database keeps what is known about
# them. An upload writes both, which is what a flow with two destinations is
# for.

# Store an uploaded file and record it
flow "upload_file" {
  from {
    connector = "api"
    operation = "POST /files"
  }

  transform {
    filename    = "input.filename"
    content     = "input.content"
    size        = "size(input.content)"
    uploaded_at = "now()"
  }

  # The bytes: the destination names the file the message carries. Whatever
  # comes out of that is resolved under the connector's base_path.
  to {
    connector = "storage"
    target    = "input.filename"
    format    = "text"
  }

  # And what is known about it — the row keeps the name and the size, not the
  # bytes, so the destination shapes its own payload.
  to {
    connector = "db"
    target    = "files"

    transform {
      filename    = "input.filename"
      size        = "size(input.content)"
      uploaded_at = "now()"
    }
  }
}

# List what has been uploaded
flow "list_files" {
  from {
    connector = "api"
    operation = "GET /files"
  }

  to {
    connector = "db"
    target    = "files"
  }
}

# What is known about one file
flow "get_file" {
  from {
    connector = "api"
    operation = "GET /files/:filename"
  }

  to {
    connector = "db"
    target    = "files"
  }
}

# The bytes themselves
flow "download_file" {
  from {
    connector = "api"
    operation = "GET /files/:filename/content"
  }

  to {
    connector = "storage"
    target    = "input.filename"
    format    = "text"
  }
}
