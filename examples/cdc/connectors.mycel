# PostgreSQL CDC connector - streams WAL changes in real-time
connector "pg_cdc" {
  type   = "cdc"
  driver = "postgres"

  host     = env("DB_HOST", "localhost")
  port     = env("DB_PORT", "5432")
  database = env("DB_NAME", "myapp")
  user     = env("DB_USER", "replication_user")
  password = env("DB_PASSWORD")

  # A slot holds WAL until this service confirms it, so a second service
  # watching the same database needs a slot of its own.
  slot_name   = env("CDC_SLOT", "mycel_slot")
  publication = env("CDC_PUBLICATION", "mycel_pub")
}

# REST API to expose endpoints
connector "api" {
  type = "rest"
  port = 3000
}

# SQLite for local event log
connector "events_db" {
  type     = "database"
  driver   = "sqlite"
  database = "./data/events.db"
}
