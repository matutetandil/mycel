# S3 Example Configuration
# This example shows how to work with S3/MinIO storage

service {
  name    = "s3-example"
  version = "1.0.0"
}

# REST API to expose file operations
connector "api" {
  type = "rest"
  port = 3000
}

# AWS S3 connector
connector "s3" {
  type   = "s3"
  driver = "s3"

  # Credentials come from the environment. Written into the file they are
  # either a placeholder nobody can run or a secret nobody should commit.
  bucket     = env("S3_BUCKET", "my-bucket")
  region     = env("AWS_REGION", "us-east-1")
  access_key = env("AWS_ACCESS_KEY_ID", "")
  secret_key = env("AWS_SECRET_ACCESS_KEY", "")
  prefix     = "uploads/"
  format     = "json"
}

# MinIO connector (S3-compatible)
connector "minio" {
  type   = "s3"
  driver = "s3"

  bucket         = env("MINIO_BUCKET", "local-bucket")
  endpoint       = env("MINIO_ENDPOINT", "http://localhost:9000")
  access_key     = env("MINIO_ACCESS_KEY", "minioadmin")
  secret_key     = env("MINIO_SECRET_KEY", "minioadmin")
  use_path_style = true  # Required for MinIO
  prefix         = "data/"
}

# Database for file metadata
connector "db" {
  type     = "database"
  driver   = "sqlite"
  database = "./data/s3.db"
}
