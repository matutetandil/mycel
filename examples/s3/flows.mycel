# S3 File Operations Flows
#
# NOTE: This is a simplified example. Advanced S3 operations require
# parser support for 'operation' in 'to' blocks and 'after' hooks.

# Download from S3 - get metadata
flow "get_file_metadata" {
  from {
    connector = "api"
    operation = "GET /files/:id"
  }

  to {
    connector = "db"
    target    = "files"
  }
}

# List file metadata from database
flow "list_files" {
  from {
    connector = "api"
    operation = "GET /files"
  }

  to {
    connector = "db"
    target    = "files"
  }
}

# Store an object and record it
#
# The bytes go to the bucket and what is known about them to the database —
# one flow, two destinations.
flow "upload_file" {
  from {
    connector = "api"
    operation = "POST /upload"
  }

  to {
    connector = "minio"
    target    = "input.filename"
    format    = "text"
    params    = { content = "input.content" }
  }

  to {
    connector = "db"
    target    = "files"

    transform {
      id          = "uuid()"
      filename    = "input.filename"
      key         = "input.filename"
      size        = "size(input.content)"
      uploaded_at = "now()"
    }
  }
}

# Fetch an object's bytes back out of the bucket
flow "download_file" {
  from {
    connector = "api"
    operation = "GET /download/:filename"
  }

  to {
    connector = "minio"
    target    = "input.filename"
    format    = "text"
  }
}

# A link to the object that carries its own permission, for handing to a
# browser without proxying the bytes through this service.
flow "presign_file" {
  from {
    connector = "api"
    operation = "GET /presigned/:filename"
  }

  step "url" {
    connector = "minio"
    operation = "presign_get"
    params    = { key = "input.filename", expires_in = "3600" }
  }

  transform {
    filename = "input.filename"
    url      = "step.url.url"
  }
}
