# REST entry point for the demo flows.
connector "api" {
  type = "rest"
  port = 8080
}

# Downstream the flows write to. Swap for any real target.
connector "downstream" {
  type     = "http"
  base_url = env("DOWNSTREAM_URL", "http://localhost:9000")
}

# Cache backing the dedupe fingerprints (memory keeps the demo self-contained;
# swap driver = "redis" + url in production).
connector "fingerprints" {
  type   = "cache"
  driver = "memory"
}

# Where the transaction writes. The two statements in `transaction
# "item_and_price"` land here, together or not at all.
connector "catalog" {
  type     = "database"
  driver   = "sqlite"
  database = "./data/catalog.db"
}
