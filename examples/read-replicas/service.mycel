# Database Read Replicas Example
# Demonstrates automatic read/write routing for PostgreSQL and MySQL

service {
  name    = "read-replicas-example"
  version = "1.0.0"
}

# ============================================
# PostgreSQL with Read Replicas
# ============================================
connector "postgres" {
  type     = "database"
  driver   = "postgres"
  host     = env("PG_PRIMARY_HOST", "pg-primary")
  port     = env("PG_PORT", "5432")
  user     = env("PG_USER", "mycel")
  password = env("PG_PASSWORD", "secret")
  database = env("PG_DATABASE", "app")

  # What the example is named after, and what it was missing: without these a
  # SELECT goes to the primary like everything else, however many comments say
  # otherwise. Each replica is tried round-robin; one that cannot be reached is
  # skipped rather than stopping the service.
  use_replicas = true

  replicas {
    host = env("PG_REPLICA_HOST", "pg-replica-1")
    port = env("PG_REPLICA_PORT", "5432")
  }

  pool {
    max = 20
  }
}

# ============================================
# MySQL with Read Replicas
# ============================================
connector "mysql" {
  type     = "database"
  driver   = "mysql"
  host     = env("MYSQL_PRIMARY_HOST", "mysql-primary")
  port     = env("MYSQL_PORT", "3306")
  user     = env("MYSQL_USER", "mycel")
  password = env("MYSQL_PASSWORD", "secret")
  database = env("MYSQL_DATABASE", "app")

  use_replicas = true

  replicas {
    host = env("MYSQL_REPLICA_HOST", "mysql-replica-1")
    port = env("MYSQL_REPLICA_PORT", "3306")
  }
}

# REST API
connector "api" {
  type = "rest"
  port = 8080
}

# Types
type "user" {
  id         = string
  name       = string
  email      = string
  created_at = string
}
