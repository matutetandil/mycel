# GraphQL Query: Get all users
# GraphQL: { users { id email name created_at } }

flow "get_users" {
  from {
    connector = "graphql_api"
    operation = "Query.users"
  }

  to {
    connector = "database"
    target    = "users"
  }

  # Without this the field is published as JSON, and `{ users { id email } }` —
  # the query this example's README shows — is refused: "Field \"users\" of
  # type \"[JSON]\" must not have a sub selection."
  returns = "User[]"
}

# GraphQL Query: Get single user by ID
# GraphQL: { user(id: 1) { id email name created_at } }

flow "get_user" {
  from {
    connector = "graphql_api"
    operation = "Query.user"
  }

  to {
    connector = "database"
    target    = "users"
    query     = "SELECT * FROM users WHERE id = :id"
  }

  returns = "User"
}

# GraphQL Mutation: Create a new user
# GraphQL: mutation { createUser(input: { email: "...", name: "..." }) { id email name } }

flow "create_user" {
  from {
    connector = "graphql_api"
    operation = "Mutation.createUser"
  }

  # The arguments of a mutation arrive flat: the input object is the message.
  transform {
    email      = "input.email"
    name       = "input.name"
    created_at = "now()"
  }

  # A mutation answers with the row it made, so the write asks for it back.
  to {
    connector = "database"
    target    = "users"
    query     = "INSERT INTO users (email, name, created_at) VALUES (:email, :name, :created_at) RETURNING *"
  }

  returns = "User"
}

# GraphQL Mutation: Update a user
# GraphQL: mutation { updateUser(id: 1, input: { name: "..." }) { id email name } }

flow "update_user" {
  from {
    connector = "graphql_api"
    operation = "Mutation.updateUser"
  }

  transform {
    id   = "input.id"
    name = "input.name"
  }

  to {
    connector = "database"
    target    = "users"
    query     = "UPDATE users SET name = :name WHERE id = :id RETURNING *"
  }

  returns = "User"
}

# GraphQL Mutation: Delete a user
# GraphQL: mutation { deleteUser(id: 1) }

flow "delete_user" {
  from {
    connector = "graphql_api"
    operation = "Mutation.deleteUser"
  }

  to {
    connector = "database"
    target    = "users"
    query     = "DELETE FROM users WHERE id = :id"
  }
}
