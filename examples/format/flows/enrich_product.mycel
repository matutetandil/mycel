# Mixed format flow - JSON input, XML enrichment step, JSON output
# Demonstrates step-level format declarations

flow "enrich_product" {
  from {
    connector = "api"
    operation = "POST /products/enrich"
  }

  # Step 1: Save to local database.
  #
  # A step names what it does: without an operation this reads the table
  # rather than writing to it, and the id the next step wants is never
  # produced. The body is what gets written.
  step "save" {
    connector = "sqlite"
    target    = "products"
    operation = "INSERT"

    body = {
      name  = "input.name"
      price = "input.price"
    }
  }

  # Step 2: Enrich with data from legacy SOAP API (XML)
  # The connector already has format = "xml", but you can also set it per step.
  #
  # There is no service behind soap_api — it points at a host that does not
  # exist — so this step is here to show the shape, and the flow answers with a
  # connection error until you point it at something real.
  step "get_legacy_info" {
    connector = "soap_api"
    operation = "GET /products/details"
    format    = "xml"

    # The id travels as a parameter, not spliced into the path: ${...} is HCL's
    # interpolation, evaluated when the file is read, and `step` is a CEL
    # variable that only exists while a message is being handled. Written that
    # way the attribute cannot be evaluated at all.
    params = {
      id = "step.save.id"
    }
  }

  # Step 3: Merge and return as JSON (default)
  transform {
    id          = "step.save.id"
    name        = "input.name"
    price       = "input.price"
    legacy_code = "step.get_legacy_info.product_code"
    warehouse   = "step.get_legacy_info.warehouse"
  }
}
