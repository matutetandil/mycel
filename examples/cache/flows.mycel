# Cache Example - Flow Definitions
# =================================
# Demonstrates caching with Mycel.

# =========================================
# PATTERN 1: Simple Cache Configuration
# =========================================
# Basic caching with static keys.

flow "get_product" {
  from {
    connector = "api"
    operation = "GET /products/:id"
  }

  to {
    connector = "db"
    target    = "products"
  }

  # Cache with static key
  # Referencing the named cache rather than repeating its settings. The
  # storage and the TTL come from `cache "products"` next door; only the key
  # is particular to this flow.
  cache {
    use = "cache.products"
    key = "item"
  }
}

# =========================================
# PATTERN 2: List Caching
# =========================================
# Cache list endpoints.

flow "list_products" {
  from {
    connector = "api"
    operation = "GET /products"
  }

  to {
    connector = "db"
    target    = "products"
  }

  cache {
    use = "cache.lists"
    key = "products:all"
  }
}

flow "list_users" {
  from {
    connector = "api"
    operation = "GET /users"
  }

  to {
    connector = "db"
    target    = "users"
  }

  cache {
    use = "cache.lists"
    key = "users:all"
  }
}

# =========================================
# PATTERN 3: Write Operations (No Cache)
# =========================================
# Write operations should not be cached.

flow "create_product" {
  from {
    connector = "api"
    operation = "POST /products"
  }

  to {
    connector = "db"
    target    = "products"
  }
  # No cache block - writes go directly to database
}

flow "create_user" {
  from {
    connector = "api"
    operation = "POST /users"
  }

  to {
    connector = "db"
    target    = "users"
  }
}

# =========================================
# PATTERN 4: Health Check (No Cache)
# =========================================
# Some endpoints shouldn't be cached.

flow "health_check" {
  from {
    connector = "api"
    operation = "GET /status"
  }

  to {
    connector = "db"
    target    = "products"
  }
  # No cache block - always hits the database
}

# =========================================
# PATTERN 3: Cache Invalidation
# =========================================
# A write drops what it made stale. Without these the cached product survived
# its own update, and the walkthrough in README.md — which is the whole
# demonstration of invalidation — had nothing to call.

flow "update_product" {
  from {
    connector = "api"
    operation = "PUT /products/:id"
  }

  to {
    connector = "db"
    target    = "products"
  }

  after {
    invalidate {
      storage  = "memory_cache"
      keys     = ["products:item"]
      patterns = ["lists:products:*"]
    }
  }
}

flow "delete_product" {
  from {
    connector = "api"
    operation = "DELETE /products/:id"
  }

  to {
    connector = "db"
    target    = "products"
  }

  after {
    invalidate {
      storage  = "memory_cache"
      keys     = ["products:item"]
      patterns = ["lists:products:*"]
    }
  }
}

# =========================================
# PATTERN 5: Sharing a namespace with another service
# =========================================
# The cache is not always ours alone. During a migration the service being
# replaced is still up, still reading and writing the same keys, and it
# encodes them its own way — here, gzip(base64(JSON.stringify(value))).
#
# Without `encoding` this is not merely incompatible, it is destructive: the
# entry cannot be decoded, that reads as a miss, the flow does the work and
# writes plain JSON over the key, and the other service fails on its next
# read. They take turns destroying each other's entries and the only visible
# symptom is a cache that never seems to hit.
flow "get_shared_product" {
  from {
    connector = "api"
    operation = "GET /shared/products/:id"
  }

  to {
    connector = "db"
    target    = "products"
  }

  cache {
    storage  = "memory_cache"
    ttl      = "5m"
    key      = "shared:product:${input.id}"
    encoding = ["json", "base64", "gzip"]
  }
}

# =========================================
# PATTERN 6: Dropping a key set the configuration cannot count
# =========================================
# `keys` is one key out per template in: the values vary with the message, the
# number does not. Here the set is whatever the query returned — one entry per
# store view the product appears in — so its size is a function of the data.
#
# A wildcard is not a substitute when the members diverge: one broad enough to
# catch them all also deletes entries for unrelated products.
flow "republish_product" {
  from {
    connector = "api"
    operation = "PUT /products/:id/republish"
  }

  step "affected" {
    connector = "db"
    query     = "SELECT store_code FROM product_stores WHERE product_id = :id"
    params    = { id = "input.id" }
    on_error  = "fail"
  }

  to {
    connector = "db"
    target    = "products"
  }

  after {
    invalidate {
      storage = "memory_cache"
      # One fixed key, plus one per row the step returned. The two are unioned.
      keys      = ["products:item"]
      keys_from = "step.affected.map(r, 'product:' + input.id + ':' + r.store_code)"
    }
  }
}
