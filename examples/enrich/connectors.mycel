# Connectors configuration

# REST API connector (exposes endpoints)
connector "api" {
  type = "rest"
  port = 3000
}

# Product database
connector "products_db" {
  type   = "database"
  driver = "sqlite"

  database = "./products.db"
}

# Pricing service. Not part of this example — point it at your own, or at
# anything that answers a price. (A TCP or gRPC service works the same way from
# a flow's side; see the tcp and grpc examples for those connectors.)
connector "pricing_service" {
  type = "http"

  base_url = env("PRICING_URL", "http://localhost:9001")
  timeout  = "5s"

  # Sent with every request this connector makes. What belongs here is what
  # never changes per call — who is asking, what it accepts — rather than
  # anything a flow computes, which goes on the step instead.
  headers {
    Accept       = "application/json"
    User-Agent   = "mycel-enrich/1.0"
    X-Api-Key    = env("PRICING_API_KEY", "demo-key")
  }
}

# Inventory service, likewise.
connector "inventory_service" {
  type = "http"

  base_url = env("INVENTORY_URL", "http://localhost:8080/api")
  timeout  = "5s"
}
