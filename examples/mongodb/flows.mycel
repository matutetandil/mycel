# MongoDB Operations Flows

# List all documents
flow "list_users" {
  from {
    connector = "api"
    operation = "GET /users"
  }
  to {
    connector = "mongo"
    target    = "users"
  }
}

# Get document by ID using query_filter
flow "get_user" {
  from {
    connector = "api"
    operation = "GET /users/:id"
  }
  to {
    connector    = "mongo"
    target       = "users"
    query_filter = { "_id" = ":id" }
  }
}

# Query with filters
flow "get_active_users" {
  from {
    connector = "api"
    operation = "GET /users/active"
  }
  to {
    connector    = "mongo"
    target       = "users"
    query_filter = { status = "active" }
  }
}

# Query with range filters
flow "get_recent_users" {
  from {
    connector = "api"
    operation = "GET /users/recent"
  }
  to {
    connector = "mongo"
    target    = "users"
    query_filter = {
      created_at = { "$gte" = "input.since" }
      status     = "active"
    }
  }
}

# Create a document
flow "create_user" {
  from {
    connector = "api"
    operation = "POST /users"
  }
  transform {
    name       = "input.name"
    email      = "input.email"
    status     = "'active'"
    created_at = "now()"
  }
  to {
    connector = "mongo"
    target    = "users"
    operation = "INSERT_ONE"
  }
}

# Update a document
flow "update_user" {
  from {
    connector = "api"
    operation = "PUT /users/:id"
  }
  to {
    connector    = "mongo"
    target       = "users"
    operation    = "UPDATE_ONE"
    query_filter = { "_id" = ":id" }
    update = {
      "$set" = {
        name       = "input.name"
        email      = "input.email"
        updated_at = "now()"
      }
    }
  }
}

# Delete a document
flow "delete_user" {
  from {
    connector = "api"
    operation = "DELETE /users/:id"
  }
  to {
    connector    = "mongo"
    target       = "users"
    operation    = "DELETE_ONE"
    query_filter = { "_id" = ":id" }
  }
}

# Search by name, which is what a document store is good at: the filter is a
# Mongo query, so anything Mongo understands can go in it.
flow "search_users" {
  from {
    connector = "api"
    operation = "GET /users/search"
  }
  to {
    connector    = "mongo"
    target       = "users"
    query_filter = {
      name = { "$regex" = "input.q", "$options" = "i" }
    }
  }
}

# The last payload per SKU, kept for a month.
#
# `conflict_key` says what identifies the record, so the second message about a
# SKU replaces the first instead of adding a document. `ttl` hands the expiry
# to Mongo: Mycel creates the TTL index and writes each document's own
# deadline, and Mongo does the deleting.
flow "archive_payload" {
  from {
    connector = "api"
    operation = "POST /archive"
  }

  to {
    connector    = "mongo"
    target       = "payload_archive"
    conflict_key = "sku"
    on_conflict  = "replace"
    ttl          = "30d"
  }
}

# What was last archived for one SKU.
flow "get_archived_payload" {
  from {
    connector = "api"
    operation = "GET /archive/:sku"
  }

  to {
    connector    = "mongo"
    target       = "payload_archive"
    query_filter = { sku = ":sku" }
  }
}

# The same thing written from an aspect, which is how a service that already
# has its own flows keeps a record of what arrived without touching them.
aspect "archive_last_request" {
  on   = ["create_user", "update_user"]
  when = "after"

  action {
    connector    = "mongo"
    target       = "request_archive"
    conflict_key = "flow"
    on_conflict  = "replace"
    ttl          = "7d"

    transform {
      flow     = "_flow"
      received = "now()"
      request  = "input"
    }
  }
}
