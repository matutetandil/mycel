connector "postgres" {
  type     = "database"
  driver   = "postgres"
  host     = env("DB_HOST", "localhost")
  # From the environment like the rest of the connection: a fixed port means a
  # reader whose Postgres is not on 5432 cannot point this at it, however much
  # they set DB_HOST.
  port     = env("DB_PORT", "5432")
  database = env("DB_NAME", "orders")
  user     = env("DB_USER", "mycel")
  password = env("DB_PASSWORD", "mycel")
  sslmode  = "disable"
}

connector "shipping_api" {
  type     = "http"
  base_url = env("SHIPPING_API_URL", "http://localhost:4000")
}

connector "notifications" {
  type     = "http"
  base_url = env("NOTIFICATION_API_URL", "http://localhost:5000")
}
