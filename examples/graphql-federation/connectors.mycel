# GraphQL Federation Connectors

# GraphQL Server with Subscriptions
# Federation v2 is on by default on every GraphQL server — gateways (Apollo
# Router, Cosmo) discover and compose this subgraph without being told to. The
# block below is only needed to pin the version, or to turn it off.

connector "api" {
  type   = "graphql"
  driver = "server"

  port       = 4000
  endpoint   = "/graphql"
  playground = true

  cors {
    origins = ["*"]
    methods = ["GET", "POST", "OPTIONS"]
    headers = ["Content-Type", "Authorization"]
  }

  # The schema this server serves. `auto_generate` builds it from the flows
  # and types in this directory, which is what makes the configuration the
  # single description of the service; `path` reads an .graphql file instead,
  # for a schema somebody else owns.
  schema {
    auto_generate = true
  }

  # Federation is on by default. Written out, the block pins the version — and
  # `enabled = false` turns it off, which is what you want on a server that
  # should not publish its schema through `_service { sdl }`.
  federation {
    enabled = true
    version = 2
  }

  # Enable GraphQL Subscriptions over WebSocket
  subscriptions {
    enabled = true
    path    = "/subscriptions"
  }
}

# SQLite Database for product and review storage
connector "db" {
  type   = "database"
  driver = "sqlite"

  # A file, not ":memory:": each connection in the pool gets its own private
  # in-memory database, so what a migration creates is not there when a query
  # arrives.
  database = env("DB_PATH", "./data/federation.db")
}

# RabbitMQ for event-driven subscriptions
# In production, price updates arrive via a message queue and are pushed
# to subscribers in real time.

connector "events" {
  type   = "mq"
  driver = "rabbitmq"

  host     = env("RABBITMQ_HOST", "localhost")
  port     = 5672
  username = env("RABBITMQ_USER", "guest")
  password = env("RABBITMQ_PASS", "guest")
  vhost    = "/"

  queue {
    name              = "product_events"
    durable           = true
    create_if_missing = true
  }

  exchange {
    name              = "product_exchange"
    type              = "topic"
    durable           = true
    routing_key       = "product.*"
    create_if_missing = true
  }

  consumer {
    auto_ack    = false
    concurrency = 1
    prefetch    = 10
  }
}
